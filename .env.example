# ─────────────────────────────────────────────────────────────────────────────
# Vaultly — environment configuration
# Copy this file to .env and fill in the values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Add ?sslmode=require for managed providers.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vaultly?schema=public"

# Random secret (32+ chars) used to sign CSRF + share-unlock tokens.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin of the app. Used for share links, emails and cookies.
# In production this MUST be your https:// domain.
APP_URL="http://localhost:3000"

# ── First administrator (used by `npm run setup` / `npm run db:seed`) ────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisAfterFirstLogin1!"
ADMIN_NAME="Platform Admin"

# ── Storage ──────────────────────────────────────────────────────────────────
# local = filesystem (development / single server)
# s3    = any S3-compatible object storage (S3, R2, B2, MinIO, Spaces…)
STORAGE_DRIVER="local"

# Local driver settings
STORAGE_LOCAL_DIR="./storage/uploads"

# S3-compatible driver settings (required when STORAGE_DRIVER=s3)
# S3_BUCKET="my-vaultly-bucket"
# S3_REGION="auto"                                  # AWS: e.g. eu-west-1
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""                                    # R2/B2/MinIO endpoint; omit for AWS
# S3_FORCE_PATH_STYLE="false"                       # true for MinIO/B2
# S3_PUBLIC_BASE_URL=""                             # optional public bucket URL
# CDN_BASE_URL=""                                   # optional CDN in front of the bucket

# ── Uploads ──────────────────────────────────────────────────────────────────
# Hard ceiling for a single file in bytes (overrides the admin setting).
# MAX_UPLOAD_BYTES="2147483648"
# Optional path to ffprobe for video duration/resolution metadata.
# FFPROBE_PATH="/usr/bin/ffprobe"

# ── Email (optional — can also be configured in Admin → Settings → Email) ────
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASSWORD=""

# ── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV="production"
# DATABASE_POOL_MAX="10"
# Set to "true" when running behind a trusted reverse proxy / load balancer so
# client IPs are read from X-Forwarded-For (enables accurate rate limiting).
# TRUST_PROXY="false"
# DATABASE_SSL="false"
# FORCE_CONFIGURED_ORIGIN="false"
