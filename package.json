{
  "name": "vaultly",
  "version": "1.0.0",
  "private": true,
  "description": "Vaultly — self-hosted cloud storage hosting panel with admin-managed quotas, public sharing, media delivery and embedding.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/local-db.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "drizzle-orm": "^0.45.4",
    "file-type": "^19.6.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.29",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
